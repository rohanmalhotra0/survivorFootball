# Runtime variables are injected by your host; never commit secrets.
# The app does not load .env files automatically. See docs/FREE_HOSTING.md.
PORT=3000

# Supabase + Vercel (Vercel selects the hosted backend automatically).
# Set APP_BACKEND=supabase when running the hosted backend locally.
# APP_BACKEND=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# Supabase quickstart aliases NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are also accepted.
# Never use a NEXT_PUBLIC_ prefix for the secret/service-role key.
# Legacy SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are also supported.
# Enter secrets in Vercel's Environment Variables, never in browser code.
# CRON_SECRET=  # generate a random value of at least 32 bytes
# APP_ORIGIN=https://YOUR_PROJECT.vercel.app
# Optional: build:vercel derives this public URL from SUPABASE_URL by default.
# VITE_PLAYER_ASSET_BASE_URL=https://YOUR_PROJECT.supabase.co/storage/v1/object/public/player-portraits

# Local SQLite or persistent single-server hosting.
# APP_ORIGIN=https://survivor.example.com
# DATABASE_PATH=/persistent-data/survivor.sqlite
# NODE_ENV=production
# NODE_USE_ENV_PROXY=1
